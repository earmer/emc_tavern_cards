{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "环境": {
      "default": {},
      "type": "object",
      "properties": {
        "日期": {
          "default": "",
          "type": "string"
        },
        "时间": {
          "default": "",
          "type": "string"
        },
        "📍": {
          "default": "",
          "type": "string"
        }
      }
    },
    "夏夏": {
      "default": {},
      "type": "object",
      "properties": {
        "基础属性": {
          "default": {},
          "type": "object",
          "properties": {
            "姓名": {
              "default": "",
              "type": "string"
            },
            "体力": {
              "default": 100,
              "type": "number"
            },
            "饥饿感": {
              "default": 0,
              "type": "number"
            },
            "特殊阶段": {
              "default": "",
              "type": "string"
            }
          }
        },
        "情绪": {
          "default": {},
          "type": "object",
          "properties": {
            "心情": {
              "default": 50,
              "type": "number"
            },
            "欲望": {
              "default": 0,
              "type": "number"
            }
          }
        },
        "动态状态": {
          "default": {},
          "type": "object",
          "properties": {
            "正在": {
              "default": "",
              "type": "string"
            },
            "次数": {
              "default": 0,
              "type": "number"
            },
            "👗": {
              "default": "",
              "type": "string"
            },
            "Debuff": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string",
                "description": "状态名"
              },
              "additionalProperties": {
                "type": "string",
                "description": "状态描述"
              }
            }
          }
        },
        "物品栏": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "description": "物品名"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "描述": {
                "type": "string"
              },
              "数量": {
                "type": "number"
              }
            },
            "required": [
              "描述",
              "数量"
            ]
          }
        },
        "小记系统": {
          "default": {},
          "type": "object",
          "properties": {
            "小记": {
              "default": "",
              "type": "string"
            },
            "历史小记": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}